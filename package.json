{
  "name": "notebooklm-api",
  "version": "0.2.3",
  "description": "Unofficial TypeScript/JavaScript client and CLI for Google NotebookLM API",
  "author": "e-yc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-yc/notebooklm-api.git"
  },
  "homepage": "https://github.com/e-yc/notebooklm-api#readme",
  "bugs": {
    "url": "https://github.com/e-yc/notebooklm-api/issues"
  },
  "keywords": [
    "notebooklm",
    "google",
    "ai",
    "notebook",
    "podcast",
    "audio",
    "video",
    "slide-deck",
    "api",
    "client",
    "typescript",
    "cli"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/index.js",
      "types": "./dist/cli/index.d.ts"
    }
  },
  "bin": {
    "notebooklm": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.0.0",
    "zod": "^4.3.5"
  },
  "optionalDependencies": {
    "playwright": "^1.52.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
